{
  "name": "mga-in",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MGA India website and desktop app",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:electron": "vite build --mode electron",
    "preview": "vite preview",
    "sitemap": "node scripts/generate-sitemap.js",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build:electron && electron-builder --win",
    "electron:dist:win": "electron-builder --win",
    "electron:dist:mac": "electron-builder --mac",
    "electron:dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^5.4.8",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "in.mga.app",
    "productName": "MGA",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "MGA-Setup.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitpal8429/mga_in.git"
  },
  "keywords": [],
  "author": "MGA",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/amitpal8429/mga_in/issues"
  },
  "homepage": "https://github.com/amitpal8429/mga_in#readme",
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron-winstaller@5.4.0": true
  }
}
